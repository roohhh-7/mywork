generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("Active") // Active, Paused, Completed, Archived
  color       String?  // Optional hex color
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notes         Note[]
  links         Link[]
  files         File[]
  progressItems ProgressItem[]
}

model Note {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  content   String
  color     String?
  tags      String?  // Comma separated tags for simplicity MVP
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Link {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  url         String
  description String?
  color       String?
  tags        String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model File {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  storagePath String
  fileType    String
  fileSize    Int
  description String?
  color       String?
  tags        String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ProgressItem {
  id         String   @id @default(uuid())
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  content    String
  completed  Boolean  @default(false)
  color      String?
  createdAt  DateTime @default(now())
  completedAt DateTime?
}

model Tag {
  id    String @id @default(uuid())
  name  String @unique
  color String?
}
